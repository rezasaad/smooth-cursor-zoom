{
  "manifest_version": 3,
  "name": "Smooth Cursor Zoom",
  "version": "2.2.0",
  "description": "با شورتکات، به‌صورت نرم روی محل نشانگر ماوس زوم کنید.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "shared/settings.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-area-selection": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "شروع رسم محدودهٔ زوم"
    }
  },
  "action": {
    "default_title": "Smooth Cursor Zoom",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
